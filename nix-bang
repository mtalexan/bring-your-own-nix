#
# This script is for use in a shebang that wants to run the script containing it
# using an interpreter from a Nix devShell. The devShell is a flake directory or a
# classic *.nix file. Nested shebang scripts can call each other.
#
# WARNING: devShell requires nscd or nsncd running on the host!
#          glibc automatically delegates to it when present, which is required if any
#          nsswitch.conf is ever used, or if almost any host tools need to be run.
# WARNING: A classic *.nix file, or the selected attribute, must evaluate to a pkgs.mkShell.
#          A package expression such as a typical default.nix built with mkDerivation is not supported.
# WARNING: nix-portable ships a nixpkgs channel pinned when that nix-portable was built, which
#          can be as much as two years old. An unpinned nixpkgs in a classic *.nix file uses that
#          channel. niv and npins can pin a newer nixpkgs for the rest of the derivation, but the
#          niv or npins tool itself still comes from that channel.
# WARNING: The classic pre-build only asks Nix whether the inputDerivation is already in the store.
#          If the evaluated inputs are unchanged, including when an niv or npins lock was not
#          updated, nothing is rebuilt.
#
# Args:
#   1: A flake directory, or a classic *.nix file.
#      A path whose name ends in .nix is always a classic file and must be a regular file.
#      shell.nix is the conventional name. Any other *.nix name is also accepted.
#      A directory whose name ends in .nix is rejected. Any other path must be a directory
#      containing flake.nix. There is no fallback from a directory, or from one filename
#      to another. Pass the *.nix file explicitly.
#      The stack id uses the absolute path without resolving symlinks. The same project
#      reached through a different symlink is a different devShell.
#   2: Flake devShell name, or a classic attribute path. Blank becomes `default` in
#      __NIX_SHEBANG_STACK for both. For a classic file, `default` is only that placeholder:
#      it is not passed to nix develop, and it means the file's own derivation.
#   3: Interpreter to use for the file
#   4: Always "$0" from the shebang call
#   5*: Always "$@" from the shebang call
#
# Environment:
#   See the environment variables for nix-devshell-enter and byo-nix, which are passed through.
#
#   NIX_SHEBANG_DEVSHELL_MERGE=(unset)
#     Lists devShells that are independent of each other. Scripts that use this trampoline
#     often call each other. Re-entering a devShell that is already active is slow, so the
#     trampoline tracks the devShells it has entered. When another devShell has been entered
#     since then, it cannot tell whether that one changed something the earlier one set, so
#     by default it enters again. Within one set, listed devShells are treated as
#     non-conflicting, so an earlier one still counts as active when only members of that
#     set have been entered after it.
#     Comma-separated sets. Each set is a pipe-separated list of entries. Blank comma entries
#     are ignored, so appending ",..." is always safe. Blank pipe entries are an error. Sets
#     are not combined with each other.
#     Paths are absolute and must match the path given to the trampoline, without resolving
#     symlinks. A trailing / is ignored.
#     Flake: the directory containing flake.nix. /proj means every devShell in that flake.
#     /proj#name means only that devShell, and /proj#default is the default devShell.
#     Classic: the full path to the .nix file. /proj/shell.nix means every attribute of that
#     file, including the file's own derivation when no attribute is given.
#     /proj/shell.nix#name means only that attribute, and /proj/shell.nix#default is the
#     file's derivation when no attribute was passed.
#     /proj and /proj/shell.nix are different entries. A flake directory never covers a
#     classic file in it.
#     A flake directory whose name ends in .nix is not supported. Any path ending in .nix
#     is treated as a classic file, so such a directory fails as an invalid .nix file.
#
#   NIX_DEVSHELL_ENTER_WRAPPER=(script dir)/nix-devshell-enter
#     The path to the script that wraps the byo-nix calls for entering a devShell.
#     It is not called when the trampoline decides the devShell is already active.
#
#   __NIX_SHEBANG_STACK
#     Reserved. Leave it unset when starting a command.
#
# Examples:
#   Keep each shebang within 127 characters. proot 5.1.0 truncates a longer line and env -S
#   exits 125. Export a merge list in the script instead of putting it on the shebang line.
#   Flake directory, default devShell:
#     #!/usr/bin/env -S sh -c 'd=$(dirname "$0");"$d"/tools/nix-bang "$d"/flake_dir "" python3 "$0" "$@"'
#   Flake directory, named devShell:
#     #!/usr/bin/env -S sh -c 'd=$(dirname "$0");"$d"/tools/nix-bang "$d"/flake_dir rubyDev ruby "$0" "$@"'
#   Classic shell.nix, no attribute:
#     #!/usr/bin/env -S sh -c 'd=$(dirname "$0");"$d"/tools/nix-bang "$d"/shell.nix "" python3 "$0" "$@"'
#   Named attribute in another *.nix file:
#     #!/usr/bin/env -S sh -c 'd=$(dirname "$0");"$d"/tools/nix-bang "$d"/dev.nix cowsay cowsay "$0" "$@"'
#   A flake directory and a shell.nix declared independent:
#     NIX_SHEBANG_DEVSHELL_MERGE="${NIX_SHEBANG_DEVSHELL_MERGE},$(pwd)/flake_dir|$(pwd)/shell.nix"
#     export NIX_SHEBANG_DEVSHELL_MERGE


SCRIPT_DIR="$(cd "$(dirname "${0}")" && pwd)"

die() {
    [ $# -eq 0 ] || echo >&2 "ERROR:" "$@"
    exit 1
}

# POSIX shell check for an absolute path, looks for leading '/'
is_abs_path() {
    dir="$1"

    echo "$dir" | grep -qE '^/' 1>/dev/null 2>&1
}

# Drop trailing slashes from a flake directory. The directory containing flake.nix may
# be written with or without a trailing slash. A path of only slashes stays "/".
# Args:
#  1: Flake directory path
normalize_flake_path() {
    _flake_path="$1"
    [ -n "$_flake_path" ] || return 0
    _flake_path=$(printf '%s\n' "$_flake_path" | sed -E -e 's@/+$@@')
    if [ -z "$_flake_path" ]; then
        printf '%s\n' /
    else
        printf '%s\n' "$_flake_path"
    fi
}

# Normalize a merge or stack entry. A bare directory stays a bare directory.
# ${flake_abs_path}#${devShell} keeps its devShell name and drops trailing slashes on the directory.
# Args:
#  1: Flake directory, or flake directory plus #devShell
normalize_devshell_id() {
    _raw_id="$1"
    case "$_raw_id" in
        *\#*)
            _norm_path=$(normalize_flake_path "${_raw_id%%#*}")
            _norm_name="${_raw_id#*#}"
            printf '%s\n' "${_norm_path}#${_norm_name}"
            ;;
        *)
            normalize_flake_path "$_raw_id"
            ;;
    esac
}

#-------------------------------
# Environment
#-------------------------------

if [ -z "$NIX_DEVSHELL_ENTER_WRAPPER" ]; then
    NIX_DEVSHELL_ENTER_WRAPPER="${SCRIPT_DIR}/nix-devshell-enter"
fi

[ -f "$NIX_DEVSHELL_ENTER_WRAPPER" ] || die "No such nix-devshell-enter: ${NIX_DEVSHELL_ENTER_WRAPPER}"
[ -x "$NIX_DEVSHELL_ENTER_WRAPPER" ] || die "Not executable nix-devshell-enter: ${NIX_DEVSHELL_ENTER_WRAPPER}"

#-------------------------------
# Args
#-------------------------------

# There must be at least an interpreter and a script path, otherwise we aren't using the shebang
[ $# -ge 4 ] || die "Too few arguments. USAGE: $0 <flake_dir_or_nix_file> <devShell_or_attr> <interpreter> <script_path> [<script_args>...]"

_target_arg="$1"
_devshell_arg="$2"
shift 2
# The rest are the interpreter, the script path, and any script arguments.

# A trailing slash does not change the kind of path. "/" itself stays "/".
_target_stripped=$(printf '%s\n' "$_target_arg" | sed -E -e 's@/+$@@')
[ -n "$_target_stripped" ] || _target_stripped=/

_stack_path=
case "$_target_stripped" in
    *.nix)
        [ -f "$_target_stripped" ] || die "Invalid .nix file: ${_target_stripped}"
        _stack_parent=$(CDPATH= cd "$(dirname "$_target_stripped")" && pwd) || die "Invalid .nix file: ${_target_stripped}"
        _stack_parent=$(normalize_flake_path "$_stack_parent")
        if [ "$_stack_parent" = / ]; then
            _stack_path="/$(basename "$_target_stripped")"
        else
            _stack_path="${_stack_parent}/$(basename "$_target_stripped")"
        fi
        ;;
    *)
        [ -d "$_target_stripped" ] || die "Flake directory doesn't exist: ${_target_stripped}"
        [ -f "${_target_stripped}/flake.nix" ] || die "No 'flake.nix' in flake directory: ${_target_stripped}. Pass the .nix file explicitly."
        _stack_path=$(CDPATH= cd "$_target_stripped" && pwd)
        _stack_path=$(normalize_flake_path "$_stack_path")
        ;;
esac

# Blank is stored as #default for both flakes and classic files. For a classic file that
# placeholder is not an attribute named default.
if [ -z "$_devshell_arg" ]; then
    _nix_flake_devshell="${_stack_path}#default"
else
    _nix_flake_devshell="${_stack_path}#${_devshell_arg}"
fi

#-------------------------------
# Stack Check helpers
#-------------------------------

# Check if a value is in a pipe-separated list
# Args:
#  1: Value to look form
#  2: Pipe-separated list to look in (may be empty)
is_in_pipe_list() {
    _value="$1"
    _list="$2"

    [ -z "$_list" ] && return 1

    # Match the value literally. Set strings contain '|' and paths may contain
    # other ERE metacharacters, which would otherwise split the pattern.
    _value_re=$(printf '%s\n' "$_value" | sed -e 's/[.[\*^$()+?{|]/\\&/g')

    # Use start and end of string anchors, or pipe separator char to bound the value match
    if echo "${_list}" | grep -qE "(^|[|])${_value_re}([|]|\$)" 1>/dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

# Extend the pipe-separated list if the value isn't already present in it.
# Args:
#  1: Value to add
#  2: Current list (may be blank)
# Outputs to stdout the new list
add_to_pipe_list() {
    if [ -z "$2" ]; then
        echo "$1"
    elif is_in_pipe_list "$1" "$2"; then
        echo "$2"
    else
        echo "${1}|${2}"
    fi
}

# Check whether a ${flake_abs_path}#${devShell} id is covered by a pipe-separated merge list.
# A list token matches when it is the full id, or when it is only the flake directory.
# The bare directory is shorthand for every devShell in that flake. ${flake_abs_path} is the
# directory containing flake.nix, not the flake.nix file.
# Args:
#  1: Flake+devShell id
#  2: Pipe-separated merge list (may be empty)
devshell_in_merge_list() {
    _merge_id="$1"
    _merge_list="$2"

    [ -z "$_merge_list" ] && return 1

    if is_in_pipe_list "$_merge_id" "$_merge_list"; then
        return 0
    fi

    _merge_path="${_merge_id%%#*}"
    is_in_pipe_list "$_merge_path" "$_merge_list"
}

# Creates a pipe-separated list of flake+devShell ids that are defined as independent
# from the requested flake+devShell.
# Transitivity does not apply across comma-separated sets, so only sets that explicitly
# include the requested id are collected. A requested id may appear in more than one set.
# 
# WARNING: Matching is text-based. Flake paths must be absolute and must not have symlinks
#          resolved. The devShell name is the output name only, without the devShells.<system>. prefix.
# Args:
#   1: The flake+devShell id to look for, ${flake_abs_path}#${devShell}, where ${flake_abs_path}
#      is the directory containing flake.nix
# Environment:
#   NIX_SHEBANG_DEVSHELL_MERGE
#     The comma-separated list of sets. Each set is a pipe-separated list of
#     ${flake_abs_path}#${devShell} entries, or bare ${flake_abs_path} entries that stand for every
#     devShell in that flake. A comma-separated set may be empty, but a pipe-separated entry cannot
#     be blank. A # with an empty devShell name is invalid.
#   
build_compatible_devshell_set_list() {
    _devshell_to_find=$(normalize_devshell_id "$1")
    _compatible_devshells=""

    if [ -n "$NIX_SHEBANG_DEVSHELL_MERGE" ]; then
        set -f # turn off globbing so we can safely parse the lists
        _old_ifs1="$IFS"
        IFS=','
        for _devshell_set in $NIX_SHEBANG_DEVSHELL_MERGE; do
            IFS="$_old_ifs1" # reset IFS back to normal for the loop body
            
            [ -n "$_devshell_set" ] || continue # skip blank comma-separated entries

            _old_ifs2="$IFS"
            IFS='|'
            _normalized_set=""
            for _devshell_id in $_devshell_set; do
                IFS="$_old_ifs2" # reset IFS back to normal for the loop body
                
                [ -n "$_devshell_id" ] || die "Invalid NIX_SHEBANG_DEVSHELL_MERGE: pipe-separated flake+devShell entries cannot be blank: '$_devshell_set'"
                # A bare flake directory means every devShell in that flake. An explicit entry is
                # ${flake_abs_path}#${devShell}. The path is the directory containing flake.nix.
                # A trailing slash on that directory is ignored.
                case "$_devshell_id" in
                    *\#*)
                        _path="${_devshell_id%%#*}"
                        _name="${_devshell_id#*#}"
                        if [ -z "$_path" ] || [ -z "$_name" ]; then
                            die "Invalid NIX_SHEBANG_DEVSHELL_MERGE: entries must be a flake directory or absolute_flake_path#devShell, where absolute_flake_path is the directory containing flake.nix: '$_devshell_id'"
                        fi
                        ;;
                esac
                _normalized_id=$(normalize_devshell_id "$_devshell_id")
                if [ -z "$_normalized_set" ]; then
                    _normalized_set="$_normalized_id"
                else
                    _normalized_set="${_normalized_set}|${_normalized_id}"
                fi
            done
            IFS="$_old_ifs2"

            if devshell_in_merge_list "$_devshell_to_find" "$_normalized_set"; then
                _compatible_devshells="$(add_to_pipe_list "$_normalized_set" "$_compatible_devshells")"
            fi
        done
        IFS="$_old_ifs1"
        set +f # turn globbing back on (the default)
    fi

    echo "$_compatible_devshells"
}

# Are we already in the correct devShell for the given flake+devShell?
# Args:
#   1: The flake dir (absolute path) + devShell, sepearated by a '#' that we are requesting
# Environment:
#   __NIX_SHEBANG_STACK
#     A pipe-separated list of ${flake_abs_path}#${devShell} entries already entered. Stack top is the start.
#   NIX_SHEBANG_DEVSHELL_MERGE
#     The comma-separated list of sets. Each set is a pipe-separated list of
#     ${flake_abs_path}#${devShell} entries, or bare flake directories that stand for every
#     devShell in that flake.
# Return Code:
#   0: Need to enter the devShell
#   1: Don't need to enter the devShell
need_devshell_enter() {
    _requested_devShell=$(normalize_devshell_id "$1")

    [ -n "$__NIX_SHEBANG_STACK" ] || return 0

    # die inside the function only exits this substitution, so propagate that failure.
    _compatible_devshells="$(build_compatible_devshell_set_list "$_requested_devShell")" || exit 1

    set -f # turn off globbing so we can safely parse the list
    old_ifs="$IFS"
    IFS='|'
    for _devShell in ${__NIX_SHEBANG_STACK}; do
        IFS="$old_ifs" # reset IFS back to normal for the loop body
        _devShell=$(normalize_devshell_id "$_devShell")

        if [ "$_devShell" = "$_requested_devShell" ]; then
            # Found the devShell in the stack, so we don't need to enter it again
            return 1
        elif ! devshell_in_merge_list "$_devShell" "$_compatible_devshells"; then
            # This stack entry is not one of the non-conflicting flake+devShells, so
            # we have to enter the devShell.
            return 0
        fi
    done
    IFS="$old_ifs"
    set +f # turn globbing back on (the default)

    # no match found, need to enter the devShell
    return 0
}

push_stack() {
    __NIX_SHEBANG_STACK="${1}|${__NIX_SHEBANG_STACK}"
}

pop_stack() {
    # remove the top of the stack, which is the first entry in the pipe-separated list
    __NIX_SHEBANG_STACK="${__NIX_SHEBANG_STACK#*|}"    
}

#-------------------------------
# DevShell Stack check
#-------------------------------

# __NIX_SHEBANG_STACK is a pipe-separated list acting as a stack of devShells we've entered.
# The top of the stack is the front of the list.
# We add to the stack when we enter a devShell to execute a command, and pop from the stack
# if we had to enter a devShell to run the command.
export __NIX_SHEBANG_STACK    

if need_devshell_enter "$_nix_flake_devshell"; then
    push_stack "$_nix_flake_devshell"

    # Enter the devShell and run the command in it
    # Pass the caller's path, not the absolute stack id. A trailing slash was already removed.
    exec "$NIX_DEVSHELL_ENTER_WRAPPER" "$_target_stripped" "$_devshell_arg" "$@"
    
    pop_stack    
else
    # We're already in the correct devShell, just run the interpreter command
    exec "$@"
fi

#
# This script is for use in a shebang that wants to run the script contianing it
# using an interpeter that's part of a nix flake devShell.
# Supports calling other specilized shebang scripts from a shebang script as well.
# 
# WARNING: devShell requires nscd or nsncd running on the host!
#          glibc automatically delegates to it when present, which is required if any
#          nsswitch.conf is ever used, or if almost any host tools need to be run.
#
# Args:
#   1: Path to folder containing a flake.nix. This will be converted to an absolute path
#      without any symlink resolution if not already an absolute path.
#      WARNING: flake matching is text based on this absolute path, so referencing the same
#               flake via a different symlink is treated as a different flake.
#   2: Name of the devShell in the flake.nix to enter. If blank, the default is used. 
#      This will always be a 'devShells.{system-type}.{name}' in the flake.nix, where system-type is auto-detected.
#      The deprecated 'devShell'/'devShell.{system-type}' in the flake.nix for the default is not supported.
#   3: Interpreter to use for the file
#   4: Always "$0" from the shebang call
#   5*: Always "$@" from the shebang call
# 
# Environment:
#   See the environment variables for nix-flake-enter and byo-nix, which will be passed thru as well.
# 
#   NIX_SHEBANG_DEVSHELL_MERGE=(unset)
#     A comma-separated list of pipe-separated flake+devShells. Each flake+devShell is
#     ${flake_abs_path}#${devShell}, the same form stored in __NIX_SHEBANG_STACK.
#     ${flake_abs_path} is the absolute path of the directory containing flake.nix, not the
#     path to the flake.nix file (e.g. /home/me/flake_dir#default, not
#     /home/me/flake_dir/flake.nix#default). The devShell
#     name is the flake output name only, without the devShells.<system>. prefix. The default
#     devShell is `default`. Blank comma-separated values are ignored, which allows unconditionally
#     extending a previously undefined value with a comma
#     (e.g. NIX_SHEBANG_DEVSHELL_MERGE+=",$(pwd)/my_flake_dir#default" is always valid), while
#     pipe-separated values cannot be blank
#     (e.g. NIX_SHEBANG_DEVSHELL_MERGE+="$(pwd)/my_flake_dir#default|" usually isn't valid).
#     A bare flake directory, with no #devShell, is shorthand for every devShell in that flake.
#     Each comma-separated set declares that those flake+devShells are independent and
#     may be overlaid in any order. See DevShell Nesting.
#     Flake paths must be absolute and must not have symlinks resolved.
#     A trailing slash on a flake directory is ignored. 
# 
#   NIX_FLAKE_ENTER_WRAPPER=(script dir)/nix-flake-enter
#     The path to the script that wraps the byo-nix calls for entering a devShell.
#     There's no guarantee this will actually be called since we may determine no additional devShell entry
#     is necessary.
# 
#   __NIX_SHEBANG_STACK
#     Reserved for internal use. A pipe-separated stack of ${flake_abs_path}#${devShell}
#     entries already entered, where ${flake_abs_path} is the directory containing flake.nix.
#     The devShell name omits the devShells.<system>. prefix, and
#     the default devShell is `default`. The top of the stack is the front of the list.
# 
# DevShell Nesting:
#   Calling a script using this script as a shebang from another script using this script as a
#   shebang is a likely scenario. When this happens, the devShell used for each shebang may or
#   may not be the same, and may or may not be from the the same flake. 
#   devShells, regardless of flake, are always overlaid on top of the current environment, even when
#   the current environemnt is another devShell. This allows an obvious optimization for when we
#   don't need to enter a new devShell subshell, when the current environment already matches the
#   one we want.
#   There are two ways the current environment can meet what we request, either the most recent devShell
#   is the same one now being requested, or someone has guaranteed that any intervening devShells that
#   may have been overlaid on top of the previously applied one being requested do not affect the same
#   things.
#   The first case is trivial, if the devShell requested is already the exact one we're in, we don't
#   need to do anything extra.
#   The second case however requires someone with knowledge of the specific flakes to inform us about
#   which can and can't affect each other. The NIX_SHEBANG_DEVSHELL_MERGE environment variable is how
#   a caller, who usually also controls the flake(s) being entered, names the flake+devShells that
#   are independent and can therefore be overlaid in any order without affecting one another.
#   An entry of ${flake_abs_path}#${devShell} names one devShell. Listing one devShell from a flake
#   does not cover the others. An entry of only ${flake_abs_path}, the directory containing flake.nix,
#   is shorthand for every devShell in that flake.
# 
#   The NIX_SHEBANG_DEVSHELL_MERGE variable has a 2-part hierarchy. Commas separate independent sets.
#   Pipes separate the entries inside one set. Two named devShells from the same flake are independent
#   when both ${flake_abs_path}#${devShell} entries are in the same set, or when the bare flake directory
#   is in that set.
# 
#   For example, when 'NIX_SHEBANG_DEVSHELL_MERGE=', this script skips re-entry only when the requested
#   flake+devShell is already the top of the stack.
#   If 'NIX_SHEBANG_DEVSHELL_MERGE=$(pwd)/flake_dir_a#default|$(pwd)/flake_dir_a#cowsay', a request for
#   '$(pwd)/flake_dir_a#default' may be satisfied by an earlier stack entry of that same id when every
#   entry above it is also in that set, including '$(pwd)/flake_dir_a#cowsay'. A different named devShell
#   from flake_dir_a that is not listed still forces re-entry.
#   'NIX_SHEBANG_DEVSHELL_MERGE=$(pwd)/flake_dir_a' is the shorthand for that same guarantee across
#   every devShell in flake_dir_a. It does not cover devShells from any other flake.
#   If 'NIX_SHEBANG_DEVSHELL_MERGE=$(pwd)/flake_dir_a#default,$(pwd)/flake_dir_b#default', the two
#   entries are separate sets. A request for flake_dir_b#default stops at flake_dir_a#default, and the
#   reverse is also true.
#   If 'NIX_SHEBANG_DEVSHELL_MERGE=$(pwd)/flake_dir_a#default|$(pwd)/flake_dir_b#cowsay,$(pwd)/flake_dir_c#default',
#   flake_dir_a#default and flake_dir_b#cowsay may overlay each other. flake_dir_c#default is a separate
#   set. A request for flake_dir_a#default does not match flake_dir_b#cowsay, and it does not treat
#   flake_dir_c#default as compatible.
#   
# 
# Examples:
#   Each of these requires a properly configured flake.nix that defines the environment(s).
# 
#   As a shebang of a python script (assuming the flake.nix has python3), using the default devShell:
#     #!/usr/bin/env -S sh -c '"$(dirname "$0")"/tools/nix-trampoline" "$(dirname "$0")/flake_dir" "" python3 "$0" "$@"'
# 
#   As a shebang of a ruby script using a custom devShell:
#     #!/usr/bin/env -S sh -c '"$(dirname "$0")"/tools/nix-trampoline" "$(dirname "$0")/flake_dir" "myRubyShell" ruby "$0" "$@"'
# 
#   As a standalone call, using the flake from the current directory to run a podman command:
#     ./tools/nix-trampoline . "isolatedPodmanShell" podman "${podman_args[@]}"
# 
#   As a shebang for a shell script where every devShell in one flake is independent and may be
#   overlaid in any order without conflict. The bare flake directory is that shorthand.
#     #!/usr/bin/env -S sh -c 'NIX_SHEBANG_DEVSHELL_MERGE+=",$(pwd)/flake_dir" "$(dirname "$0")"/tools/nix-trampoline" "$(dirname "$0")/flake_dir" "" "bash" "$0" "$@"''
# 
#   As a shebang for a shell script where specific devShells in ./flake_a and ./flake_b are independent
#   and may be overlaid in any order without conflict.
#     #!/usr/bin/env -S sh -c 'NIX_SHEBANG_DEVSHELL_MERGE+=",$(pwd)/flake_a#default|$(pwd)/flake_b#cowsay" "$(dirname "$0")"/tools/nix-trampoline" "$(dirname "$0")/flake_dir" "" "bash" "$0" "$@"''


SCRIPT_DIR="$(cd "$(dirname "${0}")" && pwd)"

die() {
    [ $# -eq 0 ] || echo >&2 "ERROR:" "$@"
    exit 1
}

# POSIX shell check for an absolute path, looks for leading '/'
is_abs_path() {
    dir="$1"

    echo "$dir" | grep -qE '^/' 1>/dev/null 2>&1
}

# Drop trailing slashes from a flake directory. The directory containing flake.nix may
# be written with or without a trailing slash. A path of only slashes stays "/".
# Args:
#  1: Flake directory path
normalize_flake_path() {
    _flake_path="$1"
    [ -n "$_flake_path" ] || return 0
    _flake_path=$(printf '%s\n' "$_flake_path" | sed -E -e 's@/+$@@')
    if [ -z "$_flake_path" ]; then
        printf '%s\n' /
    else
        printf '%s\n' "$_flake_path"
    fi
}

# Normalize a merge or stack entry. A bare directory stays a bare directory.
# ${flake_abs_path}#${devShell} keeps its devShell name and drops trailing slashes on the directory.
# Args:
#  1: Flake directory, or flake directory plus #devShell
normalize_devshell_id() {
    _raw_id="$1"
    case "$_raw_id" in
        *\#*)
            _norm_path=$(normalize_flake_path "${_raw_id%%#*}")
            _norm_name="${_raw_id#*#}"
            printf '%s\n' "${_norm_path}#${_norm_name}"
            ;;
        *)
            normalize_flake_path "$_raw_id"
            ;;
    esac
}

#-------------------------------
# Environment
#-------------------------------

if [ -z "$NIX_FLAKE_ENTER_WRAPPER" ]; then
    NIX_FLAKE_ENTER_WRAPPER="${SCRIPT_DIR}/nix-flake-enter"
fi

[ -f "$NIX_FLAKE_ENTER_WRAPPER" ] || die "No such nix-flake-enter: ${NIX_FLAKE_ENTER_WRAPPER}"
[ -x "$NIX_FLAKE_ENTER_WRAPPER" ] || die "Not executable nix-flake-enter: ${NIX_FLAKE_ENTER_WRAPPER}"

#-------------------------------
# Args
#-------------------------------

# There must be at least an interpreter and a script path, otherwise we aren't using the shebang
[ $# -ge 4 ] || die "Too few arguments. USAGE: $0 <flake_dir> <devShell_name> <interpreter> <script_path> [<script_args>...]"

_flake_dir_arg="$1"
_devshell_arg="$2"
shift 2
# The rest are the interpreter, the script path, and any script arguments.

[ -d "$_flake_dir_arg" ] || die "Flake directory doesn't exist: ${_flake_dir_arg}"
[ -f "${_flake_dir_arg}/flake.nix" ] || die "No 'flake.nix' in flake directory: ${_flake_dir_arg}"
# convert to absolute path w/o symlink resolution, and drop a trailing slash so
# /path/flake and /path/flake/ are the same flake. "/" itself is left as "/".
_flake_dir_arg=$(cd "$_flake_dir_arg" && pwd)
_flake_dir_arg=$(normalize_flake_path "$_flake_dir_arg")

# We only care about a consistent name for our stack. 
# We can assume the nix "system" type is always the same, so no need to track it too, even though it's technically part of the devShell spec.
if [ -z "$_devshell_arg" ]; then
    _nix_flake_devshell="${_flake_dir_arg}#default"
else
    _nix_flake_devshell="${_flake_dir_arg}#${_devshell_arg}"
fi

#-------------------------------
# Stack Check helpers
#-------------------------------

# Check if a value is in a pipe-separated list
# Args:
#  1: Value to look form
#  2: Pipe-separated list to look in (may be empty)
is_in_pipe_list() {
    _value="$1"
    _list="$2"

    [ -z "$_list" ] && return 1

    # Match the value literally. Set strings contain '|' and paths may contain
    # other ERE metacharacters, which would otherwise split the pattern.
    _value_re=$(printf '%s\n' "$_value" | sed -e 's/[.[\*^$()+?{|]/\\&/g')

    # Use start and end of string anchors, or pipe separator char to bound the value match
    if echo "${_list}" | grep -qE "(^|[|])${_value_re}([|]|\$)" 1>/dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

# Extend the pipe-separated list if the value isn't already present in it.
# Args:
#  1: Value to add
#  2: Current list (may be blank)
# Outputs to stdout the new list
add_to_pipe_list() {
    if [ -z "$2" ]; then
        echo "$1"
    elif is_in_pipe_list "$1" "$2"; then
        echo "$2"
    else
        echo "${1}|${2}"
    fi
}

# Check whether a ${flake_abs_path}#${devShell} id is covered by a pipe-separated merge list.
# A list token matches when it is the full id, or when it is only the flake directory.
# The bare directory is shorthand for every devShell in that flake. ${flake_abs_path} is the
# directory containing flake.nix, not the flake.nix file.
# Args:
#  1: Flake+devShell id
#  2: Pipe-separated merge list (may be empty)
devshell_in_merge_list() {
    _merge_id="$1"
    _merge_list="$2"

    [ -z "$_merge_list" ] && return 1

    if is_in_pipe_list "$_merge_id" "$_merge_list"; then
        return 0
    fi

    _merge_path="${_merge_id%%#*}"
    is_in_pipe_list "$_merge_path" "$_merge_list"
}

# Creates a pipe-separated list of flake+devShell ids that are defined as independent
# from the requested flake+devShell.
# Transitivity does not apply across comma-separated sets, so only sets that explicitly
# include the requested id are collected. A requested id may appear in more than one set.
# 
# WARNING: Matching is text-based. Flake paths must be absolute and must not have symlinks
#          resolved. The devShell name is the output name only, without the devShells.<system>. prefix.
# Args:
#   1: The flake+devShell id to look for, ${flake_abs_path}#${devShell}, where ${flake_abs_path}
#      is the directory containing flake.nix
# Environment:
#   NIX_SHEBANG_DEVSHELL_MERGE
#     The comma-separated list of sets. Each set is a pipe-separated list of
#     ${flake_abs_path}#${devShell} entries, or bare ${flake_abs_path} entries that stand for every
#     devShell in that flake. A comma-separated set may be empty, but a pipe-separated entry cannot
#     be blank. A # with an empty devShell name is invalid.
#   
build_compatible_devshell_set_list() {
    _devshell_to_find=$(normalize_devshell_id "$1")
    _compatible_devshells=""

    if [ -n "$NIX_SHEBANG_DEVSHELL_MERGE" ]; then
        set -f # turn off globbing so we can safely parse the lists
        _old_ifs1="$IFS"
        IFS=','
        for _devshell_set in $NIX_SHEBANG_DEVSHELL_MERGE; do
            IFS="$_old_ifs1" # reset IFS back to normal for the loop body
            
            [ -n "$_devshell_set" ] || continue # skip blank comma-separated entries

            _old_ifs2="$IFS"
            IFS='|'
            _normalized_set=""
            for _devshell_id in $_devshell_set; do
                IFS="$_old_ifs2" # reset IFS back to normal for the loop body
                
                [ -n "$_devshell_id" ] || die "Invalid NIX_SHEBANG_DEVSHELL_MERGE: pipe-separated flake+devShell entries cannot be blank: '$_devshell_set'"
                # A bare flake directory means every devShell in that flake. An explicit entry is
                # ${flake_abs_path}#${devShell}. The path is the directory containing flake.nix.
                # A trailing slash on that directory is ignored.
                case "$_devshell_id" in
                    *\#*)
                        _path="${_devshell_id%%#*}"
                        _name="${_devshell_id#*#}"
                        if [ -z "$_path" ] || [ -z "$_name" ]; then
                            die "Invalid NIX_SHEBANG_DEVSHELL_MERGE: entries must be a flake directory or absolute_flake_path#devShell, where absolute_flake_path is the directory containing flake.nix: '$_devshell_id'"
                        fi
                        ;;
                esac
                _normalized_id=$(normalize_devshell_id "$_devshell_id")
                if [ -z "$_normalized_set" ]; then
                    _normalized_set="$_normalized_id"
                else
                    _normalized_set="${_normalized_set}|${_normalized_id}"
                fi
            done
            IFS="$_old_ifs2"

            if devshell_in_merge_list "$_devshell_to_find" "$_normalized_set"; then
                _compatible_devshells="$(add_to_pipe_list "$_normalized_set" "$_compatible_devshells")"
            fi
        done
        IFS="$_old_ifs1"
        set +f # turn globbing back on (the default)
    fi

    echo "$_compatible_devshells"
}

# Are we already in the correct devShell for the given flake+devShell?
# Args:
#   1: The flake dir (absolute path) + devShell, sepearated by a '#' that we are requesting
# Environment:
#   __NIX_SHEBANG_STACK
#     A pipe-separated list of ${flake_abs_path}#${devShell} entries already entered. Stack top is the start.
#   NIX_SHEBANG_DEVSHELL_MERGE
#     The comma-separated list of sets. Each set is a pipe-separated list of
#     ${flake_abs_path}#${devShell} entries, or bare flake directories that stand for every
#     devShell in that flake.
# Return Code:
#   0: Need to enter the devShell
#   1: Don't need to enter the devShell
need_devshell_enter() {
    _requested_devShell=$(normalize_devshell_id "$1")

    [ -n "$__NIX_SHEBANG_STACK" ] || return 0

    # die inside the function only exits this substitution, so propagate that failure.
    _compatible_devshells="$(build_compatible_devshell_set_list "$_requested_devShell")" || exit 1

    set -f # turn off globbing so we can safely parse the list
    old_ifs="$IFS"
    IFS='|'
    for _devShell in ${__NIX_SHEBANG_STACK}; do
        IFS="$old_ifs" # reset IFS back to normal for the loop body
        _devShell=$(normalize_devshell_id "$_devShell")

        if [ "$_devShell" = "$_requested_devShell" ]; then
            # Found the devShell in the stack, so we don't need to enter it again
            return 1
        elif ! devshell_in_merge_list "$_devShell" "$_compatible_devshells"; then
            # This stack entry is not one of the non-conflicting flake+devShells, so
            # we have to enter the devShell.
            return 0
        fi
    done
    IFS="$old_ifs"
    set +f # turn globbing back on (the default)

    # no match found, need to enter the devShell
    return 0
}

push_stack() {
    __NIX_SHEBANG_STACK="${1}|${__NIX_SHEBANG_STACK}"
}

pop_stack() {
    # remove the top of the stack, which is the first entry in the pipe-separated list
    __NIX_SHEBANG_STACK="${__NIX_SHEBANG_STACK#*|}"    
}

#-------------------------------
# DevShell Stack check
#-------------------------------

# __NIX_SHEBANG_STACK is a pipe-separated list acting as a stack of devShells we've entered.
# The top of the stack is the front of the list.
# We add to the stack when we enter a devShell to execute a command, and pop from the stack
# if we had to enter a devShell to run the command.
export __NIX_SHEBANG_STACK    

if need_devshell_enter "$_nix_flake_devshell"; then
    push_stack "$_nix_flake_devshell"

    # Enter the devShell and run the command in it
    exec "$NIX_FLAKE_ENTER_WRAPPER" "$_flake_dir_arg" "$_devshell_arg" "$@"
    
    pop_stack    
else
    # We're already in the correct devShell, just run the interpreter command
    exec "$@"
fi

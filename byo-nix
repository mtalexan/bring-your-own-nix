#
# This is a wrapper script for making nix calls. It primarily does bootstrapping of
# nix-portable and then passes thru the arguments.
# nix-portable requires external locking for additions to its store if it might be
# modified in parallel, so this handles creating the *.lock flock file next to THE
# store folder if it doesn't already exist.
#
# Knowledgeable users of this script can define environment variables to reduce
# duplication of content across workspaces (nix-portable and/or the nix-portable nix-store),
# or even to point to a pre-existing working full nix install instead.
#
# WARNING: nix-portable does not include protection against simultaneous writes to its nix-store!
#          This wrapper cannot interpret every possible passthru command to add locking, so
#          it is left to the caller, though it does ensure the *.lock flock file next to the
#          store location exists.
# NOTE: This script handles parallel calls when nix-portable doesn't yet exist, by synchronizing
#       the download across all parallel calls. 
#
# Args:
#
#  All arguments are passed thru directly to the underlying nix/nix-portable tool.
#
# Environment variables:
#   BYO_NIX=(unset)
#     If set, it should be the path to a nix binary to use instead of the nix-portable binary.
#     This should only be used to point to system-installed nix, and will cause the
#     system nix store to be used as well.
#     The system nix MUST be configured to support flakes and nix commands so it matches the
#     argument format of nix-portable.
#   BYO_NIX_PORTABLE_URL=https://github.com/DavHau/nix-portable/releases/latest/download/nix-portable-$(uname -m)
#     A custom URL to download the nix-portable binary from. The download only occurs
#     if nix-portable is needed but not already present, no comparison is performed.
#     The URL is passed to the BYO_NIX_PORTABLE_DL_CMD command as a quoted argument.
#   BYO_NIX_PORTABLE_DL_CMD=(unset)
#     If set, a custom command to run to get nix-portable. The BYO_NIX_PORTABLE_URL is always
#     passed to this as the first quoted argument, and the absolute path to the BYO_NIX_PORTABLE
#     (within BYO_NIX_PORTABLE_CACHE_ROOT) is always the second argument. The command is
#     always run from the current working directory.
#     The value specified is evaled, so spaces in the value are split on by the shell, and
#     quotes escaping gets collapsed.
#     If not set, the default will use the system curl or wget depending on which is available,
#     and preferred in that order. The default system configuration of them is used, so Root CAs
#     that are the default are used as well as no authentication, no custom headers, no client
#     certificates, etc. You should provide your own command (probably as a shell script) if
#     those are necessary.
#   BYO_FORCE_DOWNLOAD=(unset)
#     If set, the BYO_NIX_PORTABLE file is always treated as missing. This can be used to performed
#     an update of an existing download to a newer URL-specified version for example.
#   BYO_NIX_PORTABLE_CACHE_ROOT=(script dir)
#     The BYO_NIX_PORTABLE and BYO_NIX_PORTABLE_STORE paths are assumed to be relative to this location
#     if not specified as absolute paths.  Can be set to a project or workspace root folder to
#     easily share the tool and the store among all scripts in the same project for example.
#     Setting this will NOT affect the directory the nix-portable command is eventually run from,
#     so paths passed as arguments to it will remain relative to the current directory.
#     The default is the folder this script is in.
#   BYO_NIX_PORTABLE=.nix-portable/nix-portable
#     The location and file name of the nix-portable binary. If the file doesn't yet exist,
#     it is downloaded with the BYO_NIX_PORTABLE_DL_CMD from the BYO_NIX_PORTABLE_URL to this location.
#     If the binary is already present it is simply used. The file must be executable already,
#     otherwise this script will attempt to modify the permissions on it to be executable.
#     This can be a location shared by multiple tools, or even a singular system location.
#     A lockfile next to this is always created if it doesn't already exist and is used to lockfile
#     read/write access to the file so it's atomic across parallel calls.
#     This path is relative to BYO_NIX_PORTABLE_CACHE_ROOT if not absolute.
#     This is ignored if BYO_NIX is set, since portable nix does not end up getting used.
#   BYO_NIX_PORTABLE_STORE=.nix-portable/nix-store
#     The name and path of the nix-portable store. It is strongly recommended that this be
#     either a project-unique store, or a location associated with your BYO_NIX_PORTABLE
#     path.
#     This should NEVER be your system nix store, since system installed nix expects to be
#     sole owner of the store and the two tools do not manage locking or store format exactly
#     the same.
#     Sharing a store between simultaneous nix-portable calls does not natively do any
#     protection against simultaneous writes!
#     It is up to the caller to provide protection against simultaneous writes if needed.
#     The one exception is nix-portable's own first-use setup of the store (unpacking its
#     bundled store paths and building gitMinimal), which this script detects and runs
#     under the store write lock before the requested command.
#     This value is ignored if BYO_NIX is set, since the system nix store is always used then.
#     When this process is already inside the nix-portable sandbox for this store
#     (/nix/store is that store), the nix binary in the store is executed directly.
#     Starting nix-portable again would nest proot or bubblewrap. Nested proot cannot
#     set PTRACE_O_TRACESECCOMP, and then either cannot find the nix binary or fails
#     later with "Operation not permitted" while reading store paths. A shebang that
#     enters another devShell from inside one hits this. __BYO_NIX_INSIDE_STORE is
#     set by this script to the store path when it starts nix-portable, so a later
#     call can recognize that sandbox without consulting the shebang stack.
#   BYO_NIX_PORTABLE_STORE_LOCKED=(unset)
#     Set by a caller that already holds the BYO_NIX_PORTABLE_STORE write lock when it calls
#     this script. The first-use check then runs without taking that lock again, which would
#     otherwise wait forever. It is not passed on to nix-portable.
#   BYO_NO_LOCK=(unset)
#     If set, no locking will be performed when downloading/checking the nix-portable and none
#     will be created for the store. 
#     This should ONLY be used when an existing store and nix-portable matching a flake.lock
#     are all being deployed together via a read-only file system location, or if it can be absolutely
#     guaranteed that only a single process on the system will be using the store and/or downloading
#     nix-portable.
#   BYO_ONLY_GET=(unset)
#     If set, the script will stop once it ensures nix-portable is available. This can be used to
#     do only the nix-portable download, and can be used in combination with BYO_FORCE_DOWNLOAD.
#     This includes making sure the nix-portable is executable if it's already been downloaded.
#     Ignored if BYO_NIX is set.
#   BYO_SELF_TEST=(unset)
#     If set, this script doesn't actually download, create, or call anything, it just performs checks
#     and prints what it finds to stderr. If BYO_NIX is set, it verifies the specified command is actually
#     present. If BYO_NIX_PORTABLE is not present it notes that and prints what would be run
#     to obtain it. If BYO_NIX_PORTABLE is present, it verifies it's executable and checks if
#     BYO_NIX_PORTABLE_STORE is already present or not.

# the directory this script is in, without any symlink resolution
SCRIPT_DIR="$(cd "$(dirname "${0}")" && pwd)"

if [ -z "$BYO_NIX_PORTABLE_URL" ]; then
    BYO_NIX_PORTABLE_URL="https://github.com/DavHau/nix-portable/releases/latest/download/nix-portable-$(uname -m)"
fi

# Wait on the BYO_NIX_PORTABLE_DL_CMD, we only want to check it when a download is actually needed

if [ -z "$BYO_NIX_PORTABLE_CACHE_ROOT" ]; then
    BYO_NIX_PORTABLE_CACHE_ROOT="$SCRIPT_DIR"
fi

if [ -z "$BYO_NIX_PORTABLE" ]; then
    BYO_NIX_PORTABLE=".nix-portable/nix-portable"
fi

if [ -z "$BYO_NIX_PORTABLE_STORE" ]; then
    BYO_NIX_PORTABLE_STORE=".nix-portable/nix-store"
fi

die() {
    [ $# -eq 0 ] || echo >&2 "ERROR:" "$@"
    exit 1
}

# POSIX shell check for an absolute path, looks for leading '/'
is_abs_path() {
    _dir="$1"

    echo "$_dir" | grep -qE '^/' 1>/dev/null 2>&1
}

# Compliant with BYO_NIX_PORTABLE_DL_CMD format, uses system curl.
# Requires the write lock to be held.
# Only prints what would be run if BYO_SELF_TEST is set
dl_with_curl() {
    _url="$1"
    _abs_dl_dest="$2"

    if [ -n "$BYO_SELF_TEST" ]; then
        echo "curl -sSLf -o \"${_abs_dl_dest}\" \"$_url\""
    else
        curl -sSLf -o "${_abs_dl_dest}" "$_url" || return $?
    fi
}

# Compliant with BYO_NIX_PORTABLE_DL_CMD format, uses system wget.
# Requires the write lock to be held.
# Only prints what would be run if BYO_SELF_TEST is set
dl_with_wget() {
    _url="$1"
    _abs_dl_dest="$2"

    if [ -n "$BYO_SELF_TEST" ]; then
        echo "wget --tries 5 -O \"${_abs_dl_dest}\" \"$_url\""
    else
        wget --tries 5 -O "${_abs_dl_dest}" "$_url" || return $?
    fi
}

# Handles calling specified command to download, or picking and calling the correct default.
# Requires the write lock to be held.
# Only prints what would be run if BYO_SELF_TEST is set
get_nix_portable() {
    _abs_dl_dest="$1"

    if [ -z "$BYO_NIX_PORTABLE_DL_CMD" ]; then
        if command -v curl 1>/dev/null 2>&1; then
            # handles only printing for BYO_SELF_TEST
            dl_with_curl "${BYO_NIX_PORTABLE_URL}" "${_abs_dl_dest}" || return $?
        elif command -v wget 1>/dev/null 2>&1; then
            # handles only printing for BYO_SELF_TEST
            dl_with_wget "${BYO_NIX_PORTABLE_URL}" "${_abs_dl_dest}" || return $?
        else
            die "Downloading nix-portable; No curl or wget present, and no BYO_NIX_PORTABLE_DL_CMD defined"
        fi
    else
        # does not handle only printing for BYO_SELF_TEST itself
        if [ -n "$BYO_SELF_TEST" ]; then
            echo >&2 "${BYO_NIX_PORTABLE_DL_CMD} \"$BYO_NIX_PORTABLE_URL\" \"$_abs_dl_dest\""
        else
            # eval it so the contents of the variables get treated like a command
            eval "${BYO_NIX_PORTABLE_DL_CMD} \"$BYO_NIX_PORTABLE_URL\" \"$_abs_dl_dest\"" || return $?
        fi
    fi
}

# Checks for and then gets nix portable if it's not present.
# Handles picking the right downloader if necessary, and creating/holding the
# read/write lock in the process.
# Args:
#   1: the absolute destination the file should be cached at. A *.lock will be looked for/created
#      next to it that's used as the read/write flock.
#      Path will be created if it doesn't exist.
# Environment:
#  BYO_SELF_TEST
#  BYO_NIX_PORTABLE_DL_CMD
#  BYO_NIX_PORTABLE_URL
#  $BYO_NO_LOCK
bootstrap_nix_portable() {
    _abs_dest="$1"
    _abs_dest_lock="${_abs_dest}.lock"
    # a temporary location to download the file to before moving it so it's written atomically
    _abs_dest_tmp="$(mktemp -u)"

    if ! [ -d "$(dirname "$_abs_dest")" ]; then
        if [ -n "$BYO_SELF_TEST" ]; then
            echo >&2 "nix-portable not found at $_abs_dest"
        else
            mkdir -p "$(dirname "$_abs_dest")" || die "Creating nix-portable cache directory: $(dirname "$_abs_dest")"
        fi
    fi

    # Create the lockfile, but only if it doesn't already exist and we're not BYO_SELF_TEST.
    if [ -z "$BYO_SELF_TEST" ] && [ -z "$BYO_NO_LOCK" ] && ! [ -f "${_abs_dest_lock}" ]; then
        touch "${_abs_dest_lock}" || die "Creating lockfile for nix-portable: ${_abs_dest_lock}"
    fi

    if ! [ -f "${_abs_dest}" ] || [ -n "$BYO_FORCE_DOWNLOAD" ] ; then
        if [ -n "$BYO_SELF_TEST" ]; then
            if [ -n "$BYO_FORCE_DOWNLOAD" ]; then
                echo >&2 "nix-portable not found (forced) at $_abs_dest"
            else
                echo >&2 "nix-portable not found at $_abs_dest"
            fi
        else
            echo >&2 "Initializing: Downloading nix-portable to $_abs_dest"
        fi

        # Download the file to a temporary location first, but do it with the write lock held so
        # parallel calls while we're downloading don't try to do their own duplicate downloads.
        _rc=0
        if [ -z "$BYO_SELF_TEST" ] && [ -z "$BYO_NO_LOCK" ]; then
            exec 9>>"${_abs_dest_lock}"
            flock -x 9
        fi
        {
            # Someone else might have been getting it while we were waiting on the write lock,
            # so check again it still doesn't exist now that we have the lock.
            if ! [ -f "${_abs_dest}" ] || [ -n "$BYO_FORCE_DOWNLOAD" ] ; then
                # make sure we'll cleanup our temp file if we exit for any reason before moving it to the final location
                trap 'rm -f "${_abs_dest_tmp}"' EXIT

                get_nix_portable "$_abs_dest_tmp" || die "Downloading nix-portable to temporary location: ${_abs_dest_tmp}"
                if [ -n "$BYO_SELF_TEST" ]; then
                    echo >&2 "chmod a+x \"${_abs_dest_tmp}\""
                    echo >&2 "mv \"${_abs_dest_tmp}\" \"${_abs_dest}\""
                else
                    chmod a+x "${_abs_dest_tmp}" || die "Enabling execute permissions for downloaded nix-portable: ${_abs_dest_tmp}"
                    mv "${_abs_dest_tmp}" "${_abs_dest}" || die "Moving downloaded nix-portable to final location: ${_abs_dest}"
                fi

                # remove our trap now that we've moved the downloaded file
                trap - EXIT
            fi
        }
        if [ -z "$BYO_SELF_TEST" ] && [ -z "$BYO_NO_LOCK" ]; then
            exec 9>&-
        fi
        [ "$_rc" -eq 0 ] || return "$_rc"
    else
        if [ -n "$BYO_SELF_TEST" ]; then # found, not forced dl, and self-test
            if [ -x "$_abs_dest" ]; then
                echo >&2 "nix-portable found at $_abs_dest"
            else
                echo >&2 "nix-portable missing execute permission"
            fi
        else
            _not_executable=
            if [ -z "$BYO_SELF_TEST" ] && [ -z "$BYO_NO_LOCK" ]; then
                exec 9>>"${_abs_dest_lock}"
                flock -s 9
            fi
            {
                [ -x "$_abs_dest" ] || _not_executable=1
            }
            if [ -z "$BYO_SELF_TEST" ] && [ -z "$BYO_NO_LOCK" ]; then
                exec 9>&-
            fi

            if [ -n "$_not_executable" ]; then
                if [ -n "$BYO_SELF_TEST" ]; then
                    echo >&2 "nix-portable missing execute permission"
                else
                    if [ -z "$BYO_NO_LOCK" ]; then
                        exec 9>>"${_abs_dest_lock}"
                        flock -x 9
                    fi
                    {
                        # if we do this twice because someone else was doing it parallel, no biggie
                        chmod a+x "${_abs_dest}" || die "Enabling execute permissions for nix-portable: ${_abs_dest}"
                    }
                    if [ -z "$BYO_NO_LOCK" ]; then
                        exec 9>&-
                    fi
                fi
            fi
        fi
    fi
}

# Makes sure a lockfile for the store is present if one doesn't already exist.
# Args:
#   1: Absolute destination of the nix-portable store. The lockfile is always *.lock matching the store.
# Environment:
#   BYO_SELF_TEST: When set, only print status to stderr, don't create anything.
#   BYO_NO_LOCK: Lockfile generation is silently skipped
bootstrap_nix_portable_store() {
    _abs_store_dest="$1"
    # strip any trailing /
    _abs_store_dest=$(echo "${_abs_store_dest}" | sed -E -e 's@/+$@@g')
    _abs_store_dest_lock="${_abs_store_dest}.lock"
    _abs_store_dest_parent_dir="$(dirname "${_abs_store_dest_lock}")"

    # if the store itself doesn't exist, make sure the parent directory of it does
    if ! [ -d "${_abs_store_dest}" ]; then
        if [ -n "$BYO_SELF_TEST" ]; then
            echo >&2 "nix-portable store not present at ${_abs_store_dest}"
        elif [ -z "$BYO_NO_LOCK" ]; then
            mkdir -p "$(dirname "${_abs_store_dest_lock}")" || die "Creating folder for nix-portable store location: ${_abs_store_dest}"
        fi
    elif [ -n "$BYO_SELF_TEST" ]; then
         echo >&2 "nix-portable store present at ${_abs_store_dest}"
    fi
        
    # if the lockfile for the store doesn't exist
    if ! [ -f "${_abs_store_dest_lock}" ]; then
        if [ -n "$BYO_SELF_TEST" ]; then
            echo >&2 "No lockfile for nix-portable store: ${_abs_store_dest_lock}"
        elif [ -z "$BYO_NO_LOCK" ]; then
            touch "${_abs_store_dest_lock}" || die "Creating nix-portable store lockfile: ${_abs_store_dest_lock}"
        fi
    elif [ -n "$BYO_SELF_TEST" ] && [ -z "$BYO_NO_LOCK" ]; then
        echo >&2 "Lockfile for nix-portable store exists: ${_abs_store_dest_lock}"
    fi
}

# Checks whether the next nix-portable call will write to its store before running the
# requested command. That happens the first time a given nix-portable binary uses a store:
# it unpacks its bundled store paths, and because NP_GIT is not used, it builds gitMinimal.
# The checks mirror the ones in the nix-portable script itself, using the fingerprint and
# gitMinimal store path read from that script.
# Args:
#   1: Absolute path of the nix-portable binary
#   2: Absolute path of the nix-portable store (NP_LOCATION)
# Returns 0 when that first-use setup is still needed, or when it can't be determined.
nix_portable_store_needs_init() {
    _np_bin="$1"
    _np_dir="$2/.nix-portable"

    [ -f "$_np_bin" ] || return 0

    _np_fingerprint=$(LC_ALL=C sed -n -e 's/^fingerprint="\([0-9a-f]*\)"$/\1/p' -e '/^fingerprint="/q' "$_np_bin" 2>/dev/null)
    _np_git=$(LC_ALL=C sed -n -e 's@^if \$doInstallGit && \[ ! -e \$store/\([^ ]*\) \] ; then$@\1@p' -e '/^if \$doInstallGit && /q' "$_np_bin" 2>/dev/null)

    { [ -n "$_np_fingerprint" ] && [ -n "$_np_git" ]; } || return 0
    [ -f "$_np_dir/conf/fingerprint" ] || return 0
    [ "$(cat "$_np_dir/conf/fingerprint")" = "$_np_fingerprint" ] || return 0
    [ -e "$_np_dir/nix/store/$_np_git" ] || return 0
    return 1
}

# Prints the /nix/store path of nix when this process is already inside the
# nix-portable sandbox for the given store. A system /nix/store is a different
# directory, so this stays silent there and the caller starts nix-portable as usual.
# Args:
#   1: Absolute nix-portable store path, without a trailing slash
# Output:
#   /nix/store/<hash>-nix-<version>/bin/nix
# Returns 1 when this process is not inside that store, or nix cannot be found in it.
nix_binary_inside_portable_store() {
    _in_store="$1/.nix-portable/nix/store"
    [ -d "$_in_store" ] || return 1
    [ -d /nix/store ] || return 1

    # Same directory as this store, or this byo-nix already entered it.
    # Proot can report a different device and inode for its /nix bind than for
    # the host path, so __BYO_NIX_INSIDE_STORE covers that case. The variable
    # alone is not enough: the nix runtime does not virtualize /nix, and a
    # system store must not be selected just because the variable is set.
    _in_same=
    _in_host=$(stat -c '%d:%i' "$_in_store" 2>/dev/null) || _in_host=
    _in_guest=$(stat -c '%d:%i' /nix/store 2>/dev/null) || _in_guest=
    if [ -n "$_in_host" ] && [ "$_in_host" = "$_in_guest" ]; then
        _in_same=1
    elif [ "${__BYO_NIX_INSIDE_STORE-}" = "$1" ]; then
        _in_same=1
    fi
    [ -n "$_in_same" ] || return 1

    for _in_candidate in "$_in_store"/*-nix-*/bin/nix; do
        [ -x "$_in_candidate" ] || continue
        _in_base=$(basename "$(dirname "$(dirname "$_in_candidate")")")
        case "$_in_base" in
            *-nix-[0-9]*) ;;
            *) continue ;;
        esac
        # Reject outputs such as nix-2.20.6-man. The package name ends at the version.
        _in_ver=${_in_base#*-nix-}
        case "$_in_ver" in
            *[!0-9.]*) continue ;;
        esac
        _in_guest="/nix/store/${_in_base}/bin/nix"
        if [ -x "$_in_guest" ]; then
            printf '%s\n' "$_in_guest"
            return 0
        fi
    done
    return 1
}

# nix-portable puts its gitMinimal on PATH. A devShell replaces PATH, so a later
# nix started inside that devShell needs the same git prepended again.
# Args:
#   1: Absolute nix-portable store path, without a trailing slash
prepend_portable_git() {
    _git_store="$1/.nix-portable/nix/store"
    for _git_candidate in "$_git_store"/*-git-minimal-*/bin/git; do
        [ -e "$_git_candidate" ] || continue
        _git_base=$(basename "$(dirname "$(dirname "$_git_candidate")")")
        _git_guest="/nix/store/${_git_base}/bin/git"
        if [ -x "$_git_guest" ]; then
            PATH="$(dirname "$_git_guest"):${PATH}"
            export PATH
            return 0
        fi
    done
    return 1
}

# Runs the nix-portable first-use setup for a store while holding the store write lock,
# so it can't race with another nix-portable process writing to the same store.
# The store write lock is held while checking, and released before returning.
# Args:
#   1: Absolute path of the nix-portable binary
#   2: Absolute path of the nix-portable store, without trailing '/'
# Environment:
#   BYO_SELF_TEST: Only report whether the setup is needed.
#   BYO_NO_LOCK: Skipped. nix-portable does any setup itself, unlocked, during the requested command.
#   BYO_NIX_PORTABLE_STORE_LOCKED: The caller already holds the store write lock, so don't take it.
init_nix_portable_store() {
    _np_bin="$1"
    _np_store="$2"
    _np_store_lock="${_np_store}.lock"

    if [ -n "$BYO_SELF_TEST" ]; then
        if nix_portable_store_needs_init "$_np_bin" "$_np_store"; then
            echo >&2 "nix-portable store needs first-use setup: ${_np_store}"
        else
            echo >&2 "nix-portable store first-use setup done: ${_np_store}"
        fi
        return 0
    fi

    [ -z "$BYO_NO_LOCK" ] || return 0

    _np_locked=
    if [ -z "$BYO_NIX_PORTABLE_STORE_LOCKED" ]; then
        exec 9>>"${_np_store_lock}" || die "Opening nix-portable store lockfile: ${_np_store_lock}"
        flock -x 9
        _np_locked=1
    fi

    if nix_portable_store_needs_init "$_np_bin" "$_np_store"; then
        echo >&2 "Initializing nix-portable store: ${_np_store}"
        # Any nix-portable call does the setup before running its command.
        NP_LOCATION="${_np_store}" "$_np_bin" nix --version 1>&2 || {
            [ -z "$_np_locked" ] || exec 9>&-
            die "Initializing nix-portable store: ${_np_store}"
        }
    fi

    [ -z "$_np_locked" ] || exec 9>&-
}

#------------------------------------------------------------------------------------

if [ -n "$BYO_NIX" ]; then
    if ! [ -x "$BYO_NIX" ]; then
        if [ -n "$BYO_SELF_TEST" ]; then
            echo >&2 "Nix not found or not executable: $BYO_NIX"
        else
            die "Not found/executable BYO_NIX=$BYO_NIX"
        fi
    else
        if [ -n "$BYO_SELF_TEST" ]; then
            echo >&2 "Nix found and executable: $BYO_NIX"
        else
            # Make the call with the BYO_NIX tool, no bootstrapping.
            # Replace our current shell with this command (doesn't return to this script)
            exec $BYO_NIX "$@"
        fi
    fi
else # nix-portable
    _nix_portable_path=
    if is_abs_path "$BYO_NIX_PORTABLE"; then
        _nix_portable_path="$BYO_NIX_PORTABLE"
    else
        _nix_portable_path="${BYO_NIX_PORTABLE_CACHE_ROOT}/${BYO_NIX_PORTABLE}"
    fi

    _nix_store_path=
    if is_abs_path "$BYO_NIX_PORTABLE_STORE"; then
        _nix_store_path="$BYO_NIX_PORTABLE_STORE"
    else
        _nix_store_path="${BYO_NIX_PORTABLE_CACHE_ROOT}/${BYO_NIX_PORTABLE_STORE}"
    fi

    bootstrap_nix_portable "$_nix_portable_path" || die "Getting nix-portable"

    # download-only doesn't setup the store lockfile
    if [ -z "$BYO_ONLY_GET" ]; then
        bootstrap_nix_portable_store "${_nix_store_path}" || die "Ensuring nix-portable store can be used"

        # We cannot use NP_GIT to specify our own already-installed git. nix-portable can't
        # be sure it doesn't change between different calls, so it always unconditionally
        # replaces a symlink in the store folder on every call. This makes it unsafe to use
        # for shared stores.
        unset NP_GIT
        # Already inside this store's sandbox. Do this before first-use setup: that
        # setup runs nix-portable, which would nest proot or bubblewrap. A shebang
        # that enters a different devShell from inside one hits this. The store is
        # already initialized, because this nix came from it.
        if [ -z "$BYO_SELF_TEST" ]; then
            _inside_nix=$(nix_binary_inside_portable_store "${_abs_store_dest}") || _inside_nix=
            if [ -n "$_inside_nix" ]; then
                _np_conf="${_abs_store_dest}/.nix-portable/conf"
                if [ -f "${_np_conf}/nix.conf" ]; then
                    NIX_CONF_DIR="$_np_conf"
                    export NIX_CONF_DIR
                fi
                prepend_portable_git "${_abs_store_dest}" || true
                unset BYO_NIX_PORTABLE_STORE_LOCKED
                exec "$_inside_nix" "$@"
                die "Running nix inside the existing nix-portable store: ${_inside_nix}"
            fi
        fi

        # This detects if the store has been initialized yet and if not will initialize it. It
        # uses the store write lock for this.
        # If we're called from a script that also needed the write lock, it should have set
        # BYO_NIX_PORTABLE_STORE_LOCKED so we inherit that lock instead of grabbing it independently.
        init_nix_portable_store "${_nix_portable_path}" "${_abs_store_dest}"

        # Make sure this doesn't follow into the nix command environment we're actually running.
        unset BYO_NIX_PORTABLE_STORE_LOCKED

        if [ -z "$BYO_SELF_TEST" ]; then
            # nix-portable uses the environment variable NP_LOCATION to define where the store should be
            NP_LOCATION="${_nix_store_path}"
            export NP_LOCATION
            # Visible to later byo-nix calls inside this sandbox. Proot can hide that
            # /nix and the host store path are the same directory.
            __BYO_NIX_INSIDE_STORE="${_abs_store_dest}"
            export __BYO_NIX_INSIDE_STORE
            # 'nix-portable nix' is how you run nix commands.
            # Replace our current shell with this command (doesn't return to this script)
            exec "${_nix_portable_path}" nix "$@"
        fi
    fi
fi

# self test should always exit with an error
[ -z "$BYO_SELF_TEST" ] || exit 1
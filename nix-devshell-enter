#
# This script enters a Nix devShell and runs a command inside it. The devShell comes
# from a flake directory or from a classic *.nix file. Nix may be nix-portable and may
# need to be bootstrapped.
# 
# WARNING: devShell requires nscd or nsncd running on the host!
#          glibc automatically delegates to it when present, which is required if any
#          nsswitch modules are ever used on the host.
# WARNING: Because nix-portable doesn't manage store writes between parallel
#          calls, we need to do detection and write locking of the store for devShells that
#          require additions or updates.
# 
# Args:
#   1: A flake directory, or a classic *.nix file.
#      A path whose name ends in .nix is a classic file and must be a regular file.
#      shell.nix is the conventional name. Any other *.nix name is also accepted.
#      A directory whose name ends in .nix is rejected.
#      Any other path is a flake directory and must contain flake.nix. A directory that
#      only has a *.nix file is an error; pass that file instead. There is no fallback
#      from a missing shell.nix to default.nix.
#   2: DevShell name or classic attribute. Blank selects the flake default devShell,
#      devShells.{system}.default, or the classic file's own derivation. A classic
#      attribute is not a devShells.{system}.{name} output. The file, or that attribute,
#      must evaluate to a pkgs.mkShell.
#   3*: (optional) Command to run within the devShell, then its arguments.
#       Uses an interactive bash shell if not specified.
#
# WARNING: nix-portable ships a nixpkgs channel pinned when that nix-portable was built,
#          which can be as much as two years old. An unpinned nixpkgs in a classic *.nix
#          file uses that channel. niv and npins can pin a newer nixpkgs for the rest of
#          the derivation, but the niv or npins tool itself still comes from that channel.
# WARNING: The classic pre-build only asks Nix whether the inputDerivation is already in
#          the store. If the evaluated inputs are unchanged, including when an niv or npins
#          lock was not updated, nothing is rebuilt.
# WARNING: A native Nix install (BYO_NIX) must have the nix-command experimental feature
#          enabled. The flakes feature is required only when the target is a flake directory.
# 
# Environment:# 
#   BYO_NIX_WRAPPER=(script dir)/byo-nix
#     The location of the byo-nix script to use. Default is the same folder as this script is in.
# 
#   These are from byo-nix, but have special effects here as well.
#   BYO_NIX=(unset)
#     If set, it should be the path to a nix binary to use instead of the nix-portable binary.
#     Expected to be a system-installed nix, which handles store locking on its own, so
#     external flocking is not done when this is set. The install must have nix-command
#     enabled. flakes is required only for a flake directory. A classic *.nix file does
#     not require flakes.
#   BYO_NIX_PORTABLE_CACHE_ROOT=(script dir)
#     The BYO_NIX_PORTABLE_STORE path is relative to the location specified here.
#     The default is the folder this script is in.
#   BYO_NIX_PORTABLE_STORE=.nix-portable/nix-store
#     The name and path of the nix-portable store. A *.lock file is created next to this store to manage
#     write access to the store (reads are atomic in nix stores and don't conflict with writes).
#     Relative paths are relative to BYO_NIX_PORTABLE_CACHE_ROOT.
#   BYO_NO_LOCK=(unset)
#     If set, no locking of the store will occur, nor will any pre-check of the devShell to see if it
#     needs to be built. This option should only be used when a previously created nix-portable and
#     store are being transferred with the associated flake.lock and supplied from a read-only location
#     that doesn't allow locking. Or (not recommended even still) if you can absolutely guarantee that
#     only a single process on the system will ever possibly be trying to modify the store.
#   NSCD_SOCKET=/var/run/nscd/socket
#     Path this script checks before entering a devShell. glibc itself always uses
#     /var/run/nscd/socket. Set this only to exercise the missing-socket error.
# 
# Examples:
#   Flake directory, default devShell:
#     ./tools/nix-devshell-enter ./flake_dir "" python3 ./myscript.py arg1
#   Flake directory, named devShell:
#     ./tools/nix-devshell-enter ./flake_dir myRubyShell ruby ./script.rb
#   Classic shell.nix, the file's own derivation:
#     ./tools/nix-devshell-enter ./shell.nix "" python3 ./myscript.py arg1
#   Classic file, one attribute:
#     ./tools/nix-devshell-enter ./dev.nix cowsay cowsay hello

SCRIPT_DIR="$(cd "$(dirname "${0}")" && pwd)"

# glibc always consults /var/run/nscd/socket. The variable only changes this script's check.
if [ -z "$NSCD_SOCKET" ]; then
    NSCD_SOCKET="/var/run/nscd/socket"
fi

die() {
    [ $# -eq 0 ] || echo >&2 "ERROR:" "$@"
    exit 1
}

# POSIX shell check for an absolute path, looks for leading '/'
is_abs_path() {
    dir="$1"

    echo "$dir" | grep -qE '^/' 1>/dev/null 2>&1
}

# Detect system - matches nix's naming convention
detect_system() {
    arch="$(uname -m)"
    case "$arch" in
        # TODO: Add more supported types here
        x86_64)  echo "x86_64-linux" ;;
        aarch64) echo "aarch64-linux" ;;
        armv7l)  echo "armv7l-linux" ;;
        i686)    echo "i686-linux" ;;
        *)       die "Unrecognized host system type, mapping to Nix system type not known" ;;
    esac
}

#-------------------------------
# Environment
#-------------------------------

if [ -z "$BYO_NIX_WRAPPER" ]; then
    BYO_NIX_WRAPPER="${SCRIPT_DIR}/byo-nix"
fi
[ -f "$BYO_NIX_WRAPPER" ] || die "Missing byo-nix tool: $BYO_NIX_WRAPPER"
[ -x "$BYO_NIX_WRAPPER" ] || die "Non-executable byo-nix tool: $BYO_NIX_WRAPPER"

# needs to match the byo-nix default
if [ -z "$BYO_NIX_PORTABLE_CACHE_ROOT" ]; then
    BYO_NIX_PORTABLE_CACHE_ROOT="$SCRIPT_DIR"
fi
# needs to match the byo-nix default
if [ -z "$BYO_NIX_PORTABLE_STORE" ]; then
    BYO_NIX_PORTABLE_STORE=".nix-portable/nix-store"
fi

_nix_store_path=
if is_abs_path "$BYO_NIX_PORTABLE_STORE"; then
    _nix_store_path="$BYO_NIX_PORTABLE_STORE"
else
    _nix_store_path="${BYO_NIX_PORTABLE_CACHE_ROOT}/${BYO_NIX_PORTABLE_STORE}"
fi
# strip any trailing '/'
_nix_store_path=$(echo "${_nix_store_path}" | sed -E -e 's@/+$@@g')

_nix_store_lockfile="${_nix_store_path}.lock"

# Need to detect the hardware system type and map it to the nix type.
_nix_system="$(detect_system)"

#-------------------------------
# Args
#-------------------------------

# There must be at least 1 command, otherwise we aren't running anything in the devShell
[ $# -ge 3 ] || die "Too few arguments. USAGE: $0 <flake_dir_or_nix_file> <devShell_or_attr> <commands...>"

_target_arg="$1"
_devshell_name="$2"
shift 2
# command args are all in $@ now

# A trailing slash does not change the kind of path. "/" itself stays "/".
_target_arg=$(printf '%s\n' "$_target_arg" | sed -E -e 's@/+$@@')
[ -n "$_target_arg" ] || _target_arg=/

_target_kind=
_target_path=
_nix_devshell_attr=
_classic_input=
case "$_target_arg" in
    *.nix)
        # Name is checked before the file type so a directory named *.nix cannot be a flake.
        _target_kind=classic
        [ -f "$_target_arg" ] || die "Invalid .nix file: ${_target_arg}"
        _target_parent=$(CDPATH= cd "$(dirname "$_target_arg")" && pwd) || die "Invalid .nix file: ${_target_arg}"
        _target_parent=$(printf '%s\n' "$_target_parent" | sed -E -e 's@/+$@@')
        [ -n "$_target_parent" ] || _target_parent=/
        if [ "$_target_parent" = / ]; then
            _target_path="/$(basename "$_target_arg")"
        else
            _target_path="${_target_parent}/$(basename "$_target_arg")"
        fi
        if [ -z "$_devshell_name" ]; then
            _classic_input=inputDerivation
        else
            _classic_input="${_devshell_name}.inputDerivation"
        fi
        _nix_devshell_attr="-f ${_target_path} ${_classic_input}"
        ;;
    *)
        _target_kind=flake
        [ -d "$_target_arg" ] || die "Flake directory doesn't exist: ${_target_arg}"
        [ -f "${_target_arg}/flake.nix" ] || die "No 'flake.nix' in flake directory: ${_target_arg}. Pass the .nix file explicitly."
        # Absolute path without symlink resolution. A trailing slash was already removed.
        _target_path=$(CDPATH= cd "$_target_arg" && pwd)
        _target_path=$(printf '%s\n' "$_target_path" | sed -E -e 's@/+$@@')
        [ -n "$_target_path" ] || _target_path=/
        # Only the modern devShells.<system>.<name> output. Blank is devShells.<system>.default.
        if [ -z "$_devshell_name" ]; then
            _nix_devshell_attr="${_target_path}#devShells.${_nix_system}.default"
        else
            _nix_devshell_attr="${_target_path}#devShells.${_nix_system}.${_devshell_name}"
        fi
        ;;
esac

#-------------------------------
# Check for nscd/nsncd socket
#-------------------------------

# It's not possible to use devShells without an nscd socket, but some distros, like Fedora,
# no longer include it.
# The nscd socket is a hardcoded path in glibc that will be checked instead first before
# trying to query the nsswitch module libraries. When found, the queries are forwarded to the
# nscd socket instead, and the nsswitch module libraries run the action instead.
# Since all direct module libraries loading must exactly match the glibc version and
# somewhat closely match the build toolchain, it's effectively impossible for glibc
# in a devShell to use the nsswitch module libraries from the host system, which then prevents
# most involved system tools from working (i.e. UID querying from user name is impossible).
if [ ! -S "$NSCD_SOCKET" ]; then
    cat >&2 <<EOF
ERROR: nscd or nsncd are required on the host but not present.

The daemon must be available or isolated subshells are unable to use any nsswitch modules,
which includes all ability to look up user names among other things.

Most distros still include the complete 'nscd' daemon that creates and listens on the ${NSCD_SOCKET},
but some distros have chosen to remove it without a replacement (e.g. Fedora). For those broken,
a stand-alone Rust-based 'nsncd' tool is available from various sources that an fulfill just this
minimum system requirement without any of the additional things full 'nscd' provides that are not
needed.

Example installations:
  Ubuntu/Debian (should be present by default):
    sudo apt install nscd
    sudo systemctl enable --now nscd
    
  Fedora/RHEL (only available from a COPR repo):
    sudo dnf copr enable kanata/nsncd
    sudo dnf install nsncd
    sudo systemctl enable --now nsncd 

  Arch (only available from AUR):
    # install from AUR (varies by tools)
    sudo systemctl enable --now nsncd 

EOF
    exit 1  
fi

#-------------------------------
# Check and pre-build devShell
#-------------------------------

# if we're using nix-portable, any writes to the nix store require a write lock so avoid
# multiple processes trying to update it at the same time.

# If we're not using nix-portable (i.e. BYO_NIX is set), or locking is explicitly disabled,
# then we don't need to worry about write locks on the store and we can just let the devShell
# invocation do any store modifications automatically.
if [ -z "$BYO_NIX" ] && [ -z "$BYO_NO_LOCK" ]; then
    
    # Hold the store lock across the dry-run and any pre-build. nix-portable does not
    # protect its own store, and a dry-run can initialize or update that store.
    mkdir -p "$(dirname "$_nix_store_lockfile")" || die "Creating folder for nix-portable store lock: ${_nix_store_lockfile}"
    if [ ! -f "$_nix_store_lockfile" ]; then
        touch "$_nix_store_lockfile" || die "Creating nix-portable store write lock: ${_nix_store_lockfile}"
    fi
    exec 9>>"$_nix_store_lockfile"
    flock -x 9

    # Empty output from a successful dry-run means the devShell is already in the store.
    # byo-nix would otherwise wait on the store lock this script already holds.
    # Make sure we specify we already hold the write lock in case the store still has to be initialized too.
    # Classic files use nix build -f, which does not require the flakes feature.
    if [ "$_target_kind" = classic ]; then
        _dry_run_output=$(BYO_NIX_PORTABLE_STORE_LOCKED=1 "$BYO_NIX_WRAPPER" build --dry-run -f "$_target_path" "$_classic_input" 2>&1) || {
            exec 9>&-
            die "Getting store status for classic devShell from: '$BYO_NIX_WRAPPER' build --dry-run -f '${_target_path}' '${_classic_input}'. The target must be a pkgs.mkShell." "
$_dry_run_output"
        }
    else
        _dry_run_output=$(BYO_NIX_PORTABLE_STORE_LOCKED=1 "$BYO_NIX_WRAPPER" build --dry-run "${_nix_devshell_attr}" 2>&1) || {
            exec 9>&-
            die "Getting store status for flake devShell from: '$BYO_NIX_WRAPPER' build --dry-run  '${_nix_devshell_attr}'" "
$_dry_run_output"
        }
    fi
    
    _devshell_store_update=
    # don't really have a better way to query the status, there is no machine readable way
    if echo "${_dry_run_output}" | grep -qE '(will be built|will be fetched)'; then
        _devshell_store_update=1
    fi
    
    if [ -n "$_devshell_store_update" ]; then
        # the wrapper can remove the lock to simulate a broken byo-nix; the open fd would
        # still hold a lock on the unlinked file, so require the path itself.
        [ -f "$_nix_store_lockfile" ] || {
            exec 9>&-
            die "During call to byo-nix, no nix-portable store write lock was created: ${BYO_NIX_WRAPPER}"
        }
        
        # If we had to wait for the lock, someone may have built this same devShell.
        # However that will just cause the next command to complete really quickly, and won't be a problem.
        
        echo >&2 "Pre-building devShell for: ${_nix_devshell_attr}"
        # Use --no-link because we're just building it into the store.
        # Make sure we specify we already hold the write lock in case the store still has to be initialized too.
        # inputDerivation realizes the mkShell inputs. Building the mkShell itself is not a real build.
        if [ "$_target_kind" = classic ]; then
            BYO_NIX_PORTABLE_STORE_LOCKED=1 "$BYO_NIX_WRAPPER" build --no-link -f "$_target_path" "$_classic_input" 1>&2 || {
                exec 9>&-
                die "Pre-building the devShell with: $BYO_NIX_WRAPPER build --no-link -f '${_target_path}' '${_classic_input}'. The target must be a pkgs.mkShell."
            }
        else
            BYO_NIX_PORTABLE_STORE_LOCKED=1 "$BYO_NIX_WRAPPER" build --no-link "${_nix_devshell_attr}" 1>&2 || {
                exec 9>&-
                die "Pre-building the devShell with: $BYO_NIX_WRAPPER build --no-link '${_nix_devshell_attr}'"
            }
        fi
    fi

    # Release the write lock before entering the devShell. The build is in the store.
    exec 9>&-
fi

#-------------------------------
# Enter the devShell
#-------------------------------

# we previously shifted the args so only the command and args are in $@
# Blank is not passed as the attribute "default". That name is only a stack placeholder.
if [ "$_target_kind" = classic ]; then
    if [ $# -ge 1 ]; then
        _command="$1"
        shift
        if [ -n "$_devshell_name" ]; then
            exec "$BYO_NIX_WRAPPER" develop -f "$_target_path" "$_devshell_name" --command "$_command" "$@"
        else
            exec "$BYO_NIX_WRAPPER" develop -f "$_target_path" --command "$_command" "$@"
        fi
    elif [ -n "$_devshell_name" ]; then
        exec "$BYO_NIX_WRAPPER" develop -f "$_target_path" "$_devshell_name"
    else
        exec "$BYO_NIX_WRAPPER" develop -f "$_target_path"
    fi
elif [ -z "$_devshell_name" ]; then
    _nix_develop_arg="$_target_path"
    if [ $# -ge 1 ]; then
        _command="$1"
        shift
        exec "$BYO_NIX_WRAPPER" develop "${_nix_develop_arg}" --command "$_command" "$@"
    else
        exec "$BYO_NIX_WRAPPER" develop "${_nix_develop_arg}"
    fi
else
    _nix_develop_arg="${_target_path}#${_devshell_name}"
    if [ $# -ge 1 ]; then
        _command="$1"
        shift
        exec "$BYO_NIX_WRAPPER" develop "${_nix_develop_arg}" --command "$_command" "$@"
    else
        exec "$BYO_NIX_WRAPPER" develop "${_nix_develop_arg}"
    fi
fi